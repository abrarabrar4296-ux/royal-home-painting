{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/leads",
      "destination": "/leads.html"
    },
    {
      "source": "/dashboard",
      "destination": "/leads.html"
    },
    {
      "source": "/admin",
      "destination": "/leads.html"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}
