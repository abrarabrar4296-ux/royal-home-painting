# Server Configuration
PORT=3000
NODE_ENV=development

# Email Notification Settings
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=royalhomepainting11@gmail.com
SMTP_PASS=your_gmail_app_password_here

# Recipient Email for Lead Alerts (defaults to royalhomepainting11@gmail.com)
NOTIFICATION_EMAIL=royalhomepainting11@gmail.com

# Google Sheets Integration (for royalhomepainting11@gmail.com)
# Follow the 1-minute setup guide in google-apps-script.js to deploy your web app URL
GOOGLE_SHEET_WEBHOOK_URL=your_google_apps_script_web_app_url_here
